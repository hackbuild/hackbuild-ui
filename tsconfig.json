{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "noEmit": true,
    "paths": {
      "@hackbuild/ui": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "playground/src/**/*.ts", "playground/src/**/*.vue"]
}
