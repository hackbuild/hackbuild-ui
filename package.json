{
  "name": "@hackbuild/ui",
  "version": "0.1.0",
  "description": "The hack.build design system and Vue component library. Paper and ink, one pink, hard shadows, zero radius.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/hackbuild/hackbuild-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackbuild/hackbuild-ui.git"
  },
  "keywords": [
    "vue",
    "components",
    "design-system",
    "tailwind",
    "hackbuild"
  ],
  "files": [
    "dist",
    "assets/brand",
    "GUIDELINES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/hackbuild.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./fonts.css": "./dist/styles/fonts.css",
    "./theme.css": "./dist/styles/tailwind.css",
    "./brand/*": "./assets/brand/*"
  },
  "scripts": {
    "dev": "vite playground",
    "build": "vite build && npm run build:styles",
    "build:styles": "mkdir -p dist/styles && cp src/styles/*.css dist/styles/",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "vite preview playground"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  }
}
